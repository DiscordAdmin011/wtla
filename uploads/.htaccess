# Uploads are user-provided files — never execute them as scripts.
php_flag engine off
<IfModule mod_php.c>
    php_admin_flag engine off
</IfModule>

# Only allow images to be served from here.
<IfModule mod_authz_core.c>
    <FilesMatch "\.(?i:jpe?g|png|gif|webp)$">
        Require all granted
    </FilesMatch>
    <FilesMatch "^(?!.*\.(?i:jpe?g|png|gif|webp)$).*$">
        Require all denied
    </FilesMatch>
</IfModule>
